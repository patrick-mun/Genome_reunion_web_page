{
  "name": "genome-reunion-web-page",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "scripts": {
    "lint": "stylelint \"assets/css/**/*.css\" && html-validate \"*.html\" && eslint assets/js tooling && node tooling/check-html.mjs . && node tooling/check-dead-code.mjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec",
    "verify": "npm run lint && npm run format:check && npm run test:quiet",
    "prepare": "node tooling/install-hooks.mjs",
    "test:quiet": "node --test --test-reporter=dot",
    "visual": "node tooling/visual-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-order": "^8.1.1"
  }
}
